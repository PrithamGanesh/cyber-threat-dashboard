# ============================================================================
# LiveSOC Environment Configuration
# ============================================================================
# Copy this file to .env and update values for your environment
# NEVER commit .env with actual credentials

# DATABASE
DATABASE_URL=postgresql+asyncpg://soc:changeme@postgres:5432/livesoc
DB_USER=soc
DB_PASSWORD=changeme

# REDIS
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# API CONFIGURATION
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# THREAT INTELLIGENCE (Optional)
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# SCORING THRESHOLDS
CRITICAL_SCORE=80
HIGH_SCORE=60
MEDIUM_SCORE=40

# FRONTEND
VITE_API_URL=http://localhost:8000/api/v1
